[gd_scene format=3]

[ext_resource type="PackedScene" path="res://scenes/ui/BlackHoleBackground.tscn" id="background"]
[ext_resource type="Theme" path="res://resources/ui/menu_theme.tres" id="theme"]
[ext_resource type="Script" path="res://scripts/ui/EndScreen.cs" id="script"]

[node name="EndScreen" type="Control" node_paths=PackedStringArray("ScoreLabel", "RescuedLabel", "StarLabels", "RetryButton", "MenuButton")]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("theme")
script = ExtResource("script")
ScoreLabel = NodePath("Center/Content/ResultsPanel/Results/Score")
RescuedLabel = NodePath("Center/Content/ResultsPanel/Results/Rescued")
StarLabels = [NodePath("Center/Content/ResultsPanel/Results/Stars/Star1"), NodePath("Center/Content/ResultsPanel/Results/Stars/Star2"), NodePath("Center/Content/ResultsPanel/Results/Stars/Star3"), NodePath("Center/Content/ResultsPanel/Results/Stars/Star4"), NodePath("Center/Content/ResultsPanel/Results/Stars/Star5")]
RetryButton = NodePath("Center/Content/Buttons/RetryButton")
MenuButton = NodePath("Center/Content/Buttons/MenuButton")

[node name="BlackHoleBackground" parent="." instance=ExtResource("background")]
layout_mode = 1

